{
  "name": "sketchtogether-studio",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\"",
    "test": "node --test tests/*.test.cjs",
    "redis:check": "node --env-file=.env.local scripts/diagnose-redis.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "fabric": "6.9.0",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "2.109.0",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
