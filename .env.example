# Required for secure cloud boards and object-level collaboration:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional private Supabase Realtime transport. Both the SQL RLS policies and
# disabled public-channel access in Realtime Settings are required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# Optional durable Postgres + Storage checkpoints; never prefix service_role
# with NEXT_PUBLIC_. Apply supabase/schema.sql in the Supabase SQL editor.
SUPABASE_SERVICE_ROLE_KEY=
BACKUP_CRON_SECRET=

# Production reverse-proxy IP handling; only enable when your proxy sanitizes it.
# TRUST_PROXY_IP=true
# RATE_LIMIT_SALT=some-private-random-long-value
